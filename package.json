{
  "name": "moltcare",
  "version": "1.0.0",
  "description": "MoltCare - 让每一只刚安装的 OpenClaw Agent 都能一键获得专业级智能",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "moltcare": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "tsc --noEmit",
    "example": "npm run build && node dist/multi-expert/examples/tech-selection-example.js"
  },
  "keywords": [
    "moltcare",
    "openclaw",
    "agent",
    "ai",
    "multi-expert",
    "cli",
    "intelligence-pack"
  ],
  "author": "KimiSensen & OracleSensen",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "fastest-levenshtein": "^1.0.16",
    "handlebars": "^4.7.8",
    "inquirer": "^9.3.8",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
