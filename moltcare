#!/usr/bin/env python3
"""MoltCare v2.0 - 与 OpenClaw 深度集成的智能框架"""

import sys
import os
import argparse
import json
import yaml
import shutil
from pathlib import Path
from typing import Dict, Any, List
from datetime import datetime
import subprocess

VERSION = "2.0.0"
HOME_DIR = Path.home()
MOLTCARE_DIR = HOME_DIR / ".moltcare"
CONFIG_FILE = MOLTCARE_DIR / "config.yaml"
WORKSPACE_DIR = HOME_DIR / ".openclaw" / "workspace"
RUNTIME_DIR = MOLTCARE_DIR / "runtime"
HOOKS_DIR = MOLTCARE_DIR / "hooks"

def log(msg, level="info"):
    icons = {"info": "ℹ", "success": "✓", "warning": "⚠", "error": "✗"}
    print(f"{icons.get(level, '')} {msg}")

def ensure_dirs():
    MOLTCARE_DIR.mkdir(exist_ok=True)
    RUNTIME_DIR.mkdir(exist_ok=True)
    HOOKS_DIR.mkdir(exist_ok=True)
    WORKSPACE_DIR.mkdir(parents=True, exist_ok=True)

def load_config() -> Dict[str, Any]:
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
            return yaml.safe_load(f) or {}
    return {}

def save_config(config: Dict[str, Any]):
    ensure_dirs()
    with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
        yaml.dump(config, f, allow_unicode=True, default_flow_style=False)

def sync_to_openclaw():
    """将 MoltCare 配置同步到 OpenClaw workspace"""
    config = load_config()
    if not config.get('initialized'):
        log("MoltCare 未初始化，请先运行: moltcare init", "error")
        return False
    
    WORKSPACE_DIR.mkdir(parents=True, exist_ok=True)
    
    runtime_config = {
        'moltcare_version': VERSION,
        'last_sync': str(datetime.now()),
        'features': {
            'multi_agent': True,
            'memory_system': True,
            'heartbeat': True,
            'auto_vetting': True,
        }
    }
    
    runtime_file = RUNTIME_DIR / 'openclaw-integration.yaml'
    with open(runtime_file, 'w', encoding='utf-8') as f:
        yaml.dump(runtime_config, f, allow_unicode=True)
    
    log(f"运行时配置已同步: {runtime_file}", "success")
    return True

def install_hooks():
    """安装 OpenClaw hooks"""
    hooks = {
        'pre_message.py': '''#!/usr/bin/env python3
import sys, json
def main():
    message = sys.stdin.read()
    triggers = {
        '多专家讨论': {'signal': 10, 'action': 'force_multi_agent'},
        '这很重要': {'signal': 9, 'action': 'smart_ingest_priority'},
        '记住这个': {'signal': 8, 'action': 'smart_ingest'},
        '别忘记': {'signal': 7, 'action': 'create_reminder'},
    }
    for trigger, cfg in triggers.items():
        if trigger in message:
            print(json.dumps({'triggered': True, 'trigger': trigger, **cfg}))
            return
    print(json.dumps({'triggered': False}))
if __name__ == '__main__': main()
''',
        'heartbeat.py': '''#!/usr/bin/env python3
import json
from datetime import datetime
def main():
    print(json.dumps({'timestamp': str(datetime.now()), 'status': 'ok'}))
if __name__ == '__main__': main()
'''
    }
    
    for name, content in hooks.items():
        hook_file = HOOKS_DIR / name
        with open(hook_file, 'w', encoding='utf-8') as f:
            f.write(content)
        os.chmod(hook_file, 0o755)
        log(f"Hook 已安装: {name}", "success")

def cmd_init(args):
    """初始化命令 - v2.0 增强版"""
    print("🦞 MoltCare v2.0 初始化")
    print("")
    
    ensure_dirs()
    config = load_config()
    
    if config.get('initialized') and not args.force:
        log(f"MoltCare 已初始化 (v{config.get('version', 'unknown')})", "warning")
        log("使用 --force 重新初始化", "info")
        return
    
    new_config = {
        'version': VERSION,
        'initialized': True,
        'initializedAt': str(datetime.now()),
        'language': 'zh',
        'workspacePath': str(WORKSPACE_DIR),
        'packsDir': str(MOLTCARE_DIR / 'packs'),
        'runtimeDir': str(RUNTIME_DIR),
        'hooksDir': str(HOOKS_DIR),
        'logLevel': 'info',
        'autoUpdate': True,
        'features': {
            'deepIntegration': True,
            'autoSync': True,
            'smartMerge': True,
            'hooksEnabled': True,
            'heartbeatEnabled': True,
        },
        'sync': {'interval': 300, 'autoApplyPacks': True, 'backupBeforeMerge': True},
        'multiAgent': {'enabled': True, 'autoTrigger': True, 'minSignal': 6},
        'memory': {'system': 'vestige', 'autoCapture': True, 'signalThreshold': 7},
    }
    
    save_config(new_config)
    install_hooks()
    sync_to_openclaw()
    
    print("")
    log("初始化完成!", "success")
    print(f"  版本: MoltCare v{VERSION}")
    print(f"  工作区: {WORKSPACE_DIR}")
    print(f"  运行时: {RUNTIME_DIR}")
    print(f"  Hooks: {HOOKS_DIR}")
    print("")
    print("新特性:")
    print("  * 深度集成模式 - 配置自动同步到 OpenClaw")
    print("  * 智能合并 - 保留用户配置的同时应用新功能")
    print("  * 运行时 Hooks - pre/post message 自动触发")
    print("  * 心跳系统 - 自动任务队列和健康检查")
    print("")
    print("下一步:")
    print("  $ moltcare apply foundation-v2 --merge")
    print("  $ moltcare doctor")
    print("  $ moltcare sync")

def cmd_apply(args):
    """应用智能包 - v2.0 智能合并版"""
    pack_name = args.pack
    if not pack_name:
        log("请指定要应用的智能包名称", "error")
        return
    
    packs_dirs = [Path.cwd() / 'packs', MOLTCARE_DIR / 'packs']
    pack_path = None
    for packs_dir in packs_dirs:
        candidate = packs_dir / pack_name
        if candidate.exists() and (candidate / 'manifest.json').exists():
            pack_path = candidate
            break
    
    if not pack_path:
        log(f"智能包 '{pack_name}' 不存在", "error")
        return
    
    with open(pack_path / 'manifest.json', 'r', encoding='utf-8') as f:
        manifest = json.load(f)
    
    print(f"📦 应用智能包: {manifest.get('name', pack_name)}")
    print(f"   {manifest.get('description', '')}")
    
    if args.dry_run:
        print("")
        log("预览模式，不会实际应用更改", "info")
        return
    
    use_merge = args.merge or load_config().get('features', {}).get('smartMerge', False)
    templates_dir = pack_path / 'templates'
    
    if templates_dir.exists():
        target_dir = WORKSPACE_DIR
        for template_file in templates_dir.rglob('*'):
            if template_file.is_file():
                rel_path = template_file.relative_to(templates_dir)
                target_file = target_dir / rel_path
                
                if target_file.exists():
                    if use_merge and not args.force:
                        print(f"  🔄 智能合并: {rel_path}")
                        if load_config().get('sync', {}).get('backupBeforeMerge', True):
                            backup_dir = MOLTCARE_DIR / 'backups' / datetime.now().strftime('%Y%m%d_%H%M%S')
                            backup_dir.mkdir(parents=True, exist_ok=True)
                            shutil.copy2(target_file, backup_dir / rel_path.name)
                        
                        with open(target_file, 'r', encoding='utf-8') as f:
                            existing = f.read()
                        with open(template_file, 'r', encoding='utf-8') as f:
                            pack_content = f.read()
                        
                        if '## MoltCare Enhanced' not in existing:
                            merged = existing + '\n\n' + pack_content
                            with open(target_file, 'w', encoding='utf-8') as f:
                                f.write(merged)
                            print(f"     ✓ 已合并新内容")
                        else:
                            print(f"     ℹ 内容已存在，跳过")
                        continue
                    elif not args.force:
                        print(f"  ⚠️  跳过已存在: {rel_path}")
                        continue
                
                target_file.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(template_file, target_file)
                print(f"  📄 {rel_path}")
    
    scripts_dir = pack_path / 'scripts'
    if scripts_dir.exists():
        setup_script = scripts_dir / 'setup.sh'
        if setup_script.exists():
            print("")
            log("执行安装脚本...", "info")
            subprocess.run(['bash', str(setup_script)], check=False)
    
    sync_to_openclaw()
    log(f"智能包 '{pack_name}' 应用成功!", "success")

def cmd_sync(args):
    """手动同步配置到 OpenClaw"""
    print("🔄 同步 MoltCare 配置到 OpenClaw...")
    print("")
    if sync_to_openclaw():
        log("同步完成", "success")
        config = load_config()
        features = config.get('features', {})
        print("")
        print("当前启用的特性:")
        for feature, enabled in features.items():
            status = "✓" if enabled else "✗"
            print(f"  {status} {feature}")
    else:
        log("同步失败", "error")

def cmd_doctor(args):
    """增强版诊断命令"""
    print("🔧 MoltCare v2.0 健康诊断")
    print("")
    
    checks = []
    config = load_config()
    
    if config.get('initialized') and config.get('version', '').startswith('2.'):
        checks.append({'status': 'ok', 'message': f"MoltCare v{config.get('version')} 已初始化", 'icon': '✓'})
    elif config.get('initialized'):
        checks.append({'status': 'warning', 'message': f"需要升级 (当前 v{config.get('version')})", 'icon': '⚠'})
    else:
        checks.append({'status': 'error', 'message': 'MoltCare 未初始化', 'icon': '✗'})
    
    if (RUNTIME_DIR / 'openclaw-integration.yaml').exists():
        checks.append({'status': 'ok', 'message': 'OpenClaw 集成已启用', 'icon': '✓'})
    else:
        checks.append({'status': 'warning', 'message': 'OpenClaw 集成未配置', 'icon': '⚠'})
    
    hooks_exist = all((HOOKS_DIR / h).exists() for h in ['pre_message.py', 'heartbeat.py'])
    if hooks_exist:
        checks.append({'status': 'ok', 'message': '运行时 hooks 已安装', 'icon': '✓'})
    else:
        checks.append({'status': 'warning', 'message': '部分 hooks 缺失', 'icon': '⚠'})
    
    if WORKSPACE_DIR.exists():
        checks.append({'status': 'ok', 'message': f'OpenClaw workspace: {WORKSPACE_DIR}', 'icon': '✓'})
    else:
        checks.append({'status': 'error', 'message': 'OpenClaw workspace 不存在', 'icon': '✗'})
    
    core_files = ['SOUL.md', 'AGENTS.md', 'USER.md']
    existing = sum(1 for f in core_files if (WORKSPACE_DIR / f).exists())
    checks.append({'status': 'ok' if existing == len(core_files) else 'warning',
                   'message': f'核心文件: {existing}/{len(core_files)}', 'icon': '✓' if existing == len(core_files) else '⚠'})
    
    for check in checks:
        print(f"  {check['icon']} {check['message']}")
    
    warnings = [c for c in checks if c['status'] == 'warning']
    errors = [c for c in checks if c['status'] == 'error']
    
    print("")
    if errors:
        log(f"发现 {len(errors)} 个错误，建议运行: moltcare init --force", "error")
    elif warnings:
        log(f"发现 {len(warnings)} 个警告，建议运行: moltcare sync", "warning")
    else:
        log("所有检查通过！MoltCare v2.0 运行正常", "success")

def cmd_list(args):
    """列出智能包"""
    packs_dirs = [Path.cwd() / 'packs', MOLTCARE_DIR / 'packs']
    packs_found = []
    
    for packs_dir in packs_dirs:
        if packs_dir.exists():
            for entry in packs_dir.iterdir():
                if entry.is_dir() and not entry.name.startswith('.'):
                    manifest_file = entry / 'manifest.json'
                    if manifest_file.exists():
                        try:
                            with open(manifest_file, 'r', encoding='utf-8') as f:
                                manifest = json.load(f)
                            packs_found.append({
                                'name': manifest.get('name', entry.name),
                                'version': manifest.get('version', '0.0.1'),
                                'description': manifest.get('description', '暂无描述'),
                            })
                        except:
                            pass
    
    if args.json:
        print(json.dumps(packs_found, ensure_ascii=False, indent=2))
        return
    
    print("📦 可用智能包")
    print("")
    
    if not packs_found:
        print("未找到智能包")
        return
    
    for pack in packs_found:
        print(f"  {pack['name']} v{pack['version']}")
        print(f"    {pack['description']}")
        print()
    
    print(f"共 {len(packs_found)} 个智能包")

def cmd_status(args):
    """状态命令"""
    config = load_config()
    status_info = {
        'version': VERSION,
        'initialized': config.get('initialized', False),
        'deepIntegration': config.get('features', {}).get('deepIntegration', False),
        'workspace': str(WORKSPACE_DIR),
        'features': config.get('features', {}),
    }
    
    if args.json:
        print(json.dumps(status_info, ensure_ascii=False, indent=2))
        return
    
    print("🦞 MoltCare v2.0 状态")
    print("")
    print(f"版本:           {status_info['version']}")
    print(f"初始化:         {'✓ 已完成' if status_info['initialized'] else '✗ 未初始化'}")
    print(f"深度集成:       {'✓ 已启用' if status_info['deepIntegration'] else '✗ 未启用'}")
    print(f"OpenClaw 目录:  {status_info['workspace']}")
    
    if status_info['features']:
        print("")
        print("特性状态:")
        for name, enabled in status_info['features'].items():
            status = '✓' if enabled else '✗'
            print(f"  {status} {name}")

def main():
    parser = argparse.ArgumentParser(
        prog='moltcare',
        description='MoltCare v2.0 - 与 OpenClaw 深度集成的智能框架'
    )
    parser.add_argument('--version', action='version', version=f'%(prog)s {VERSION}')
    
    subparsers = parser.add_subparsers(dest='command', help='可用命令')
    
    init_parser = subparsers.add_parser('init', help='初始化 MoltCare v2.0')
    init_parser.add_argument('-f', '--force', action='store_true', help='强制重新初始化')
    
    list_parser = subparsers.add_parser('list', help='列出可用智能包')
    list_parser.add_argument('--json', action='store_true', help='JSON 格式输出')
    
    apply_parser = subparsers.add_parser('apply', help='应用智能包')
    apply_parser.add_argument('pack', help='智能包名称')
    apply_parser.add_argument('-f', '--force', action='store_true', help='强制覆盖')
    apply_parser.add_argument('-m', '--merge', action='store_true', help='智能合并模式')
    apply_parser.add_argument('-d', '--dry-run', action='store_true', help='预览更改')
    
    sync_parser = subparsers.add_parser('sync', help='同步配置到 OpenClaw')
    
    status_parser = subparsers.add_parser('status', help='显示状态')
    status_parser.add_argument('--json', action='store_true', help='JSON 格式输出')
    
    doctor_parser = subparsers.add_parser('doctor', help='运行健康诊断')
    doctor_parser.add_argument('--json', action='store_true', help='JSON 格式输出')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 0
    
    commands = {
        'init': cmd_init,
        'list': cmd_list,
        'apply': cmd_apply,
        'sync': cmd_sync,
        'status': cmd_status,
        'doctor': cmd_doctor,
    }
    
    if args.command in commands:
        try:
            commands[args.command](args)
        except Exception as e:
            log(f"错误: {e}", "error")
            return 1
    
    return 0

if __name__ == '__main__':
    sys.exit(main())
