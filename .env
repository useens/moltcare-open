# 凭证管理说明:
# 1. 所有敏感信息应通过环境变量注入，不要写入文件
# 2. 如必须存储，使用加密工具 (如: git-crypt, sops)
# 3. 定期检查凭证有效期和权限范围

# 需要设置的环境变量:
# export GITHUB_TOKEN="your_token_here"
# export FEISHU_APP_ID="your_app_id"
# export FEISHU_APP_SECRET="your_app_secret"  
# export NVIDIA_API_KEY="your_api_key"

