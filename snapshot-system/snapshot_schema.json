{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sensen-state-snapshot-v1",
  "title": "Sensen State Snapshot Schema",
  "description": "状态快照Schema用于记录森森运行时的完整状态，支持漂移检测和恢复",
  "version": "1.0.0",
  "type": "object",
  "required": ["version", "timestamp", "hostname", "session_id", "snapshot_type", "system", "resources", "cron", "skills", "connections", "metadata"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0",
      "description": "快照格式版本"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601格式的时间戳"
    },
    "hostname": {
      "type": "string",
      "description": "主机名"
    },
    "session_id": {
      "type": "string",
      "description": "OpenClaw会话ID"
    },
    "snapshot_id": {
      "type": "string",
      "description": "此快照的唯一ID (UUIDv4)"
    },
    "snapshot_type": {
      "type": "string",
      "enum": ["baseline", "check", "pre_shutdown", "post_startup", "manual"],
      "description": "快照类型"
    },
    "parent_snapshot_id": {
      "type": ["string", "null"],
      "description": "父快照ID，用于追踪快照链"
    },
    "system": {
      "type": "object",
      "required": ["platform", "arch", "release", "uptime", "load_average", "kernel_version"],
      "properties": {
        "platform": {"type": "string"},
        "arch": {"type": "string"},
        "release": {"type": "string"},
        "kernel_version": {"type": "string"},
        "uptime": {"type": "number", "description": "运行时间（秒）"},
        "load_average": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 3,
          "maxItems": 3
        },
        "hostname": {"type": "string"},
        "timezone": {"type": "string"}
      }
    },
    "resources": {
      "type": "object",
      "required": ["cpu", "memory", "disk"],
      "properties": {
        "cpu": {
          "type": "object",
          "required": ["usage_percent", "count", "count_logical"],
          "properties": {
            "usage_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "count": {"type": "integer"},
            "count_logical": {"type": "integer"},
            "temperature": {"type": ["number", "null"]}
          }
        },
        "memory": {
          "type": "object",
          "required": ["total_bytes", "available_bytes", "used_bytes", "usage_percent", "swap"],
          "properties": {
            "total_bytes": {"type": "integer"},
            "available_bytes": {"type": "integer"},
            "used_bytes": {"type": "integer"},
            "free_bytes": {"type": "integer"},
            "buffers_bytes": {"type": "integer"},
            "cached_bytes": {"type": "integer"},
            "usage_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "swap": {
              "type": "object",
              "properties": {
                "total_bytes": {"type": "integer"},
                "used_bytes": {"type": "integer"},
                "free_bytes": {"type": "integer"}
              }
            }
          }
        },
        "disk": {
          "type": "object",
          "required": ["partitions"],
          "properties": {
            "partitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["mount", "filesystem", "total_bytes", "used_bytes", "free_bytes", "usage_percent"],
                "properties": {
                  "mount": {"type": "string"},
                  "filesystem": {"type": "string"},
                  "device": {"type": "string"},
                  "total_bytes": {"type": "integer"},
                  "used_bytes": {"type": "integer"},
                  "free_bytes": {"type": "integer"},
                  "usage_percent": {"type": "number", "minimum": 0, "maximum": 100}
                }
              }
            }
          }
        }
      }
    },
    "cron": {
      "type": "object",
      "required": ["jobs", "enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "schedule", "command", "enabled", "status"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "schedule": {"type": "string"},
              "command": {"type": "string"},
              "enabled": {"type": "boolean"},
              "last_run": {"type": ["string", "null"]},
              "next_run": {"type": ["string", "null"]},
              "status": {"type": "string", "enum": ["idle", "running", "failed", "disabled"]},
              "last_exit_code": {"type": ["integer", "null"]},
              "run_count": {"type": "integer"}
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["count", "active_count", "services"],
      "properties": {
        "count": {"type": "integer"},
        "active_count": {"type": "integer"},
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "enabled", "last_check"],
            "properties": {
              "name": {"type": "string"},
              "description": {"type": "string"},
              "status": {"type": "string", "enum": ["active", "inactive", "error", "unknown"]},
              "enabled": {"type": "boolean"},
              "last_check": {"type": "string"},
              "error_count": {"type": "integer"},
              "health_score": {"type": "number", "minimum": 0, "maximum": 100},
              "depends_on": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "connections": {
      "type": "object",
      "required": ["active_count", "services"],
      "properties": {
        "active_count": {"type": "integer"},
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "status", "latency_ms"],
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string", "enum": ["api", "database", "message_queue", "web", "custom"]},
              "endpoint": {"type": ["string", "null"]},
              "status": {"type": "string", "enum": ["connected", "disconnected", "error", "timeout"]},
              "latency_ms": {"type": "number"},
              "last_connected": {"type": ["string", "null"]},
              "error_count": {"type": "integer"}
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "reason": {"type": ["string", "null"]},
        "source": {"type": "string"},
        "drift_detected": {"type": "boolean"},
        "drift_details": {"