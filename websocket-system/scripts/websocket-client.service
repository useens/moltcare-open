[Unit]
Description=WebSocket Client - Local Node
Documentation=https://github.com/your-org/websocket-system
After=network.target

[Service]
Type=simple
User=websocket
Group=websocket
WorkingDirectory=/opt/websocket-client
Environment=PYTHONUNBUFFERED=1
Environment=CONFIG_PATH=/etc/websocket-client/client.json

# 启动命令
ExecStart=/opt/websocket-client/venv/bin/python /opt/websocket-client/client.py --url ws://your-server:8765 --node-id local-node-01 --token demo-token-12345

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=5

# 优雅停止
TimeoutStopSec=30
KillSignal=SIGTERM

# 资源限制
LimitNOFILE=65535
LimitNPROC=2048

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/websocket-client
PrivateTmp=true

[Install]
WantedBy=multi-user.target
