{
  "client": {
    "server_url": "ws://localhost:8765",
    "node_id": "local-node-01",
    "token": "demo-token-12345",
    "node_type": "local",
    "capabilities": ["sensor", "camera", "relay"],
    "version": "1.0.0"
  },
  "reconnect": {
    "enabled": true,
    "base_delay": 1.0,
    "max_delay": 60.0,
    "max_attempts": 0
  },
  "heartbeat": {
    "interval": 30,
    "timeout": 10
  },
  "auto_response": {
    "enabled": true
  },
  "auto_report": {
    "enabled": false,
    "interval": 300
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/websocket-client/client.log"
  }
}
