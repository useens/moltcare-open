{
  "name": "openclaw-init",
  "version": "1.0.0",
  "title": "OpenClaw 初始化包",
  "description": "为新安装的 OpenClaw Agent 提供一键初始化配置，包含基础技能安装、安全配置和优化建议",
  "author": "MoltCare Team",
  "category": "foundation",
  "priority": 1,
  "isCore": true,
  "createdAt": "2026-03-12",
  "templates": [
    {
      "file": "templates/QUICKSTART.md",
      "target": "QUICKSTART.md",
      "required": true,
      "description": "快速开始指南"
    },
    {
      "file": "templates/.openclaw-workflow.yaml",
      "target": ".openclaw-workflow.yaml",
      "required": false,
      "description": "OpenClaw 工作流配置"
    }
  ],
  "scripts": {
    "apply": "scripts/setup.sh"
  },
  "dependencies": [],
  "config": {
    "backupExisting": false,
    "allowOverwrite": true,
    "validateTarget": false
  }
}
