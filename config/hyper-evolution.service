[Unit]
Description=Hyper Evolution Engine - 超进化引擎 v4.1
Documentation=https://github.com/useens/linlin-backup
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/.openclaw/workspace

# 启动命令 - v4.1正式版
ExecStartPre=/bin/sh -c 'killall -9 python3 2>/dev/null || true'
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/hyper-evolution-engine-v41.py
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/bin/sh -c 'killall -9 python3 2>/dev/null || true'

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# 系统资源限制
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=16G
CPUQuota=80%

# 环境变量
Environment="PYTHONPATH=/root/.openclaw/workspace"
Environment="HYPER_EVOLUTION_VERSION=4.1.0"
Environment="PYTHONUNBUFFERED=1"

# 安全设置
NoNewPrivileges=false
ProtectSystem=no
ProtectHome=no

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyper-evolution

[Install]
WantedBy=multi-user.target
