[Unit]
Description=Hyper Evolution Engine - 超进化引擎 v2.1 (Phase 2)
Documentation=https://github.com/useens/linlin-backup
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/.openclaw/workspace

# 启动命令 - Phase 2: 资源优化版
ExecStartPre=/bin/sh -c 'killall -9 python3 2>/dev/null || true'
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/hyper-evolution-engine-v21.py
ExecReload=/bin/kill -HUP $MAINPID
ExecStopPost=/bin/sh -c 'killall -9 python3 2>/dev/null || true'

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# 系统资源限制解除
LimitNOFILE=65536
LimitNOFILESoft=65536
LimitNPROC=4096
LimitNPROCSoft=4096
MemoryMax=16G
MemorySwapMax=0
CPUWeight=1000
CPUQuota=80%
LimitAS=infinity
LimitRSS=infinity
LimitCORE=infinity

# 环境变量
Environment="PYTHONPATH=/root/.openclaw/workspace"
Environment="HYPER_EVOLUTION_MODE=phase2"
Environment="PYTHONUNBUFFERED=1"

# 安全设置
NoNewPrivileges=false
ProtectSystem=no
ProtectHome=no

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyper-evolution

[Install]
WantedBy=multi-user.target
