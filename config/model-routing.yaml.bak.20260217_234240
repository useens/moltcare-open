# 三层智能路由架构
# 任务类型识别 → 最优模型分配

# ============ 路由层 (Step 3.5 Flash) ============
# 用于快速识别任务类型并分发，占70%日常流量
router_model: "nvidia-build/stepfun-ai/step-3.5-flash"

# ============ 任务模式识别规则 ============
task_patterns:
  # 简单任务（固定在 Step 3.5 Flash）
  - pattern: "^你好|^嗨|^Hello|^Hi|^(是|否|对|不对|好的|知道了)$"
    type: greeting_simple
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: critical
  
  - pattern: "^(测试|test)$"
    type: test
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: critical
  
  - pattern: "HEARTBEAT|心跳|状态检查"
    type: system_check
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: critical
  
  # 工具调用（固定在 Step 3.5 Flash）
  - pattern: "工具调用|函数执行|exec|run_script"
    type: tool_invocation
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: high
  
  # 日常对话（固定在 Step 3.5 Flash）
  - pattern: "^(聊|说|讲|讨论|谈谈).*"
    type: casual_chat
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: high
  
  # 复杂Agent工作流（Kimi K2.5 - k2p5）
  - pattern: "(多轮|复杂|工作流|Agent|autonomous|自主).*"
    type: complex_workflow
    target_model: "kimi-coding/k2p5"
    priority: high
  
  - pattern: "视觉|图像|图片|multimodal|多模态"
    type: vision_multimodal
    target_model: "kimi-coding/k2p5"
    priority: high
  
  # 深度推理 - 代码生成/修复（DeepSeek V3.2）
  - pattern: "(写代码|编写|生成|修复|debug|重构).*(程序|脚本|代码)"
    type: code_task
    target_model: "nvidia-build/deepseek-ai/deepseek-v3.2"
    priority: critical
  
  - pattern: "(优化|性能|算法|数据结构)"
    type: optimization
    target_model: "nvidia-build/deepseek-ai/deepseek-v3.2"
    priority: high
  
  # 数学/逻辑推理（Qwen 3.5）
  - pattern: "(数学|计算|公式|证明|逻辑|推理|解题)"
    type: math_logic
    target_model: "nvidia-build/qwen/qwen3.5-397b-a17b"
    priority: high
  
  - pattern: "(统计|概率|方程|几何|代数|微积分)"
    type: advanced_math
    target_model: "nvidia-build/qwen/qwen3.5-397b-a17b"
    priority: high
  
  # 分析与解释（默认 Step 3.5 Flash）
  - pattern: "(分析|深度|详细|架构|设计|解释|原理|机制)"
    type: analysis_explanation
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: medium
  
  # 比较/评估（默认 Step 3.5 Flash）
  - pattern: "(比较|对比|评估|选择|推荐|优劣)"
    type: comparison
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: medium
  
  # 长上下文任务（根据长度选择）
  - min_context_length: 10000
    type: long_context
    target_model: "nvidia-build/stepfun-ai/step-3.5-flash"
    priority: medium

# ============ 模型配置 ============
models:
  # 路由层 & 简单任务
  step_flash:
    id: "nvidia-build/stepfun-ai/step-3.5-flash"
    alias: "Step 3.5 Flash"
    context_window: 131072
    max_tokens: 8192
    cost_per_1k_input: 0.00001
    cost_per_1k_output: 0.00001
    purpose: "快速响应、日常对话、工具调用、任务路由"
  
  # 复杂Agent & 多模态 (kimi-coding/k2p5)
  kimi-coding/k2p5:
    id: "nvidia-build/moonshotai/kimi-k2.5"
    alias: "Kimi K2.5 (k2p5)"
    context_window: 262144
    max_tokens: 8192
    cost_per_1k_input: 0.0001
    cost_per_1k_output: 0.0001
    purpose: "复杂工作流、视觉任务、多模态理解"
  
  # 深度推理 - 代码
  deepseek_v32:
    id: "nvidia-build/deepseek-ai/deepseek-v3.2"
    alias: "DeepSeek V3.2"
    context_window: 131072
    max_tokens: 8192
    cost_per_1k_input: 0.0001
    cost_per_1k_output: 0.0001
    purpose: "代码生成、修复、深度技术任务"
  
  # 数学/逻辑
  qwen_35:
    id: "nvidia-build/qwen/qwen3.5-397b-a17b"
    alias: "Qwen 3.5"
    context_window: 131072
    max_tokens: 8192
    cost_per_1k_input: 0.0001
    cost_per_1k_output: 0.0001
    purpose: "数学计算、逻辑推理、形式化证明"

# ============ 路由策略 ============
routing_strategy:
  mode: "three_tier"
  router_model: "step_flash"
  auto_route: true
  fallback_on_error: "step_flash"
  
  # 流量估算（用于成本优化）
  traffic_weights:
    step_flash: 0.70      # 70% 简单任务
    kimi-coding/k2p5: 0.15 # 15% 复杂Agent
    deepseek_v32: 0.10    # 10% 深度代码
    qwen_35: 0.05         # 5% 数学逻辑
  
  # 置信度阈值
  confidence_threshold: 0.7
  
  # 智能回退：当高优先级模型失败时，降级到 Step 3.5 Flash
  fallback_chain:
    - "kimi-coding/k2p5" → "step_flash"
    - "deepseek_v32" → "step_flash"
    - "qwen_35" → "step_flash"
