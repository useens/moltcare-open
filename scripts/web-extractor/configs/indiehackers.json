{
  "name": "indiehackers",
  "base_url": "https://www.indiehackers.com",
  "start_url": "https://www.indiehackers.com/",
  "data_dir": "data/indiehackers",
  "concurrent_limit": 2,
  "headless": true,
  "selectors": {
    "item": "[class*=\"post\"]",
    "title": "h3, [class*=\"title\"]",
    "link": "a[href^='/post/']",
    "author": "[class*=\"user\"]",
    "votes": "[class*=\"vote\"]",
    "comments": "[class*=\"comment\"]"
  },
  "fields": {
    "title": {
      "selector": "h3",
      "attribute": "text"
    },
    "url": {
      "selector": "a[href^='/post/']",
      "attribute": "href"
    }
  },
  "pagination": {
    "type": "scroll",
    "max_scrolls": 2,
    "scroll_delay": 2000
  },
  "detail_page": {
    "enabled": false
  }
}
