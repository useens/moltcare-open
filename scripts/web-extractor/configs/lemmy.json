{
  "name": "lemmy",
  "base_url": "https://lemmy.world",
  "start_url": "https://lemmy.world/",
  "data_dir": "data/lemmy",
  "concurrent_limit": 2,
  "headless": true,
  "selectors": {
    "item": ".post",
    "title": ".post-title",
    "link": ".post-title a",
    "author": ".post-author",
    "votes": ".post-score"
  },
  "fields": {
    "title": {
      "selector": ".post-title",
      "attribute": "text"
    },
    "url": {
      "selector": ".post-title a",
      "attribute": "href"
    },
    "author": {
      "selector": ".post-author",
      "attribute": "text"
    }
  },
  "pagination": {
    "type": "scroll",
    "max_scrolls": 2,
    "scroll_delay": 1500
  },
  "detail_page": {
    "enabled": false
  }
}
