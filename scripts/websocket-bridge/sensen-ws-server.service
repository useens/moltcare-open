[Unit]
Description=Sensen WebSocket Bridge Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/websocket-bridge/server.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/sensen-ws-server.log
StandardError=append:/var/log/sensen-ws-server.log

[Install]
WantedBy=multi-user.target