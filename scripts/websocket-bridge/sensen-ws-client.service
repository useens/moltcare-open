[Unit]
Description=Sensen WebSocket Bridge Client
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/websocket-bridge/client.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/sensen-ws-client.log
StandardError=append:/var/log/sensen-ws-client.log

[Install]
WantedBy=multi-user.target