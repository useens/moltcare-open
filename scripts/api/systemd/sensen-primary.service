[Unit]
Description=Sensen Primary Node API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace
Environment="SENSEN_API_TOKEN=sensen-shared-secret-2024"
Environment="NODE_ID=primary-001"
Environment="PYTHONPATH=/root/.openclaw/workspace/scripts/api"
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/api/primary_server.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/sensen-primary.log
StandardError=append:/var/log/sensen-primary.log

[Install]
WantedBy=multi-user.target
