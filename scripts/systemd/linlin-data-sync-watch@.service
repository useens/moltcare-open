[Unit]
Description=LinLin Data Sync Watch Mode (File Change Monitor)
Documentation=https://github.com/linlin/workspace/docs/data-sync.md
After=network.target

[Service]
Type=simple
User=%I
WorkingDirectory=/home/%I/.openclaw/workspace

# 执行监控模式
ExecStart=/home/%I/.openclaw/workspace/scripts/data-sync.sh watch

# 重启策略
Restart=always
RestartSec=10

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=linlin-data-sync-watch

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%I/.openclaw/workspace

[Install]
WantedBy=multi-user.target
